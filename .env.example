# ─────────────────────────────────────────────────────────────
# Project 1 — environment configuration
# Copy to .env.local and fill in. Everything is optional:
# the app runs in a fully working demo mode without any keys.
# ─────────────────────────────────────────────────────────────

# Public URL of the site (used for links inside emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Security ────────────────────────────────────────────────
# Signs the session cookies. Generate one: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# ── First-run admin account (created automatically) ─────────
ADMIN_EMAIL=admin@beatvault.gh
ADMIN_PASSWORD=admin123
ADMIN_NAME=Studio Admin

# ── Database ────────────────────────────────────────────────
# SQLite file. Leave blank to use the default location:
#   • local dev / self-hosted:  ./data/beatvault.db
#   • serverless (Vercel, AWS Lambda): the OS temp dir, e.g.
#     /tmp/beatvault/data/beatvault.db — the deployment filesystem is
#     read-only, only /tmp is writable.
#     NOTE: /tmp is ephemeral and per-instance — for persistent data on
#     Vercel use an external database (Turso, Neon, Vercel Postgres, …).
# Only set DATABASE_PATH to point at a writable location you control.
DATABASE_PATH=

# ── Payments: Paystack ──────────────────────────────────────
# Leave blank to keep the built-in simulated checkout (demo mode).
# Fill both to start taking real Mobile Money, bank transfer and card.
#   Ghana/Nigeria Mobile Money: momo, bank, card, ussd, qr
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Paystack dashboard → Settings → Webhooks → add:
#   https://your-domain.com/api/paystack/webhook

# ── Email (SMTP) ────────────────────────────────────────────
# Leave blank and every message is composed and stored in the
# admin → Email outbox instead of being sent.
# Gmail example: host smtp.gmail.com, port 587, use an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Project 1 <orders@beatvault.gh>

# ── WhatsApp Producer Alerts (optional) ─────────────────────
# By default, booking & order messages are delivered to the
# producer's Website Inbox (/admin/messages) AND opened via
# direct wa.me links to the producer's WhatsApp number.
# To also push automatically from the server in the background,
# configure CallMeBot, a custom Webhook, or Meta Cloud API:
WHATSAPP_CALLMEBOT_KEY=
WHATSAPP_WEBHOOK_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── File storage (S3-compatible object storage) ─────────────
# Leave blank to store uploads on local disk under public/uploads.
# Works with AWS S3, Cloudflare R2, MinIO, Backblaze B2, Wasabi, and Neon
# Storage (the bucket declared in neon.ts).
#
# Generic providers: set S3_BUCKET + S3_ACCESS_KEY_ID + S3_SECRET_ACCESS_KEY,
# plus S3_ENDPOINT / S3_REGION for non-AWS providers.
# Neon Storage: `neon deploy` injects AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
# AWS_ENDPOINT_URL_S3 and AWS_REGION automatically — just also set the bucket
# name declared in neon.ts, e.g. S3_BUCKET=assets (or NEON_STORAGE_BUCKET=assets).
#
# In S3 mode the database stores a stable /api/media/<key> URL and every read is
# a short-lived presigned GET redirect, so PRIVATE buckets work for previews,
# covers, videos and paid downloads alike — no public access needed.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional Neon alias for the bucket name: NEON_STORAGE_BUCKET=assets
# Optional: public base URL when the bucket allows anonymous reads
# (not needed for private buckets — presigned URLs are used instead)
S3_PUBLIC_URL=
# Optional: force path-style addressing. Default: on when S3_ENDPOINT is set
# (required for Neon Storage and MinIO), off for AWS S3.
S3_FORCE_PATH_STYLE=
# Optional: object ACL on upload — leave unset for private buckets
S3_ACL=
# Optional: Cache-Control header stored on uploaded objects
S3_CACHE_CONTROL=
# Optional: presigned-URL lifetime in seconds (default 3600, max 604800 = 7 days)
S3_SIGNED_TTL=
